{
  "name": "hum-to-search",
  "version": "1.0.0",
  "private": true,
  "description": "Query-by-humming melody search engine: C++ trie and red-black tree compiled to WebAssembly, React + TypeScript interface.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:engine": "node scripts/build-engine.mjs",
    "test": "npm run test:engine && npm run test:web",
    "test:engine": "node scripts/gen-test-library.mjs && node scripts/test-engine.mjs",
    "test:web": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}

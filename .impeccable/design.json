  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The start action on the walnut rail: roll-sheet paper, never an accent fill.",
      "html": "<div class=\"ds-rail\"><button class=\"ds-btn ds-btn-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 4.5v15l12-7.5z\"/></svg>Play demo hum</button></div>",
      "css": ".ds-rail{background:var(--walnut);padding:12px;display:inline-flex} .ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:var(--radius-control);border:1px solid transparent;font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 140ms var(--ease-out),border-color 140ms var(--ease-out),transform 120ms var(--ease-out)} .ds-btn:active{transform:scale(.97)} .ds-btn:focus-visible{outline:none;box-shadow:var(--focus-ring)} .ds-btn-primary{background:var(--paper-hi);color:var(--ink);border-color:var(--paper-edge)} .ds-btn-primary:hover{background:var(--paper)}"
    },
    {
      "name": "Ghost Button (rail)",
      "kind": "button",
      "refersTo": "button-ghost-dark",
      "description": "Secondary actions on walnut: New search, Library.",
      "html": "<div class=\"ds-rail\"><button class=\"ds-btn ds-btn-ghost-dark\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 5h16 M4 10h16 M4 15h10 M4 20h7\"/></svg>Library</button></div>",
      "css": ".ds-rail{background:var(--walnut);padding:12px;display:inline-flex} .ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:var(--radius-control);border:1px solid transparent;font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 140ms var(--ease-out),border-color 140ms var(--ease-out),transform 120ms var(--ease-out)} .ds-btn:active{transform:scale(.97)} .ds-btn:focus-visible{outline:none;box-shadow:var(--focus-ring)} .ds-btn-ghost-dark{background:transparent;color:var(--on-walnut);border-color:var(--walnut-hi)} .ds-btn-ghost-dark:hover{background:var(--walnut-hi)}"
    },
    {
      "name": "Ghost Button (paper)",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions on paper: octave shift, drawer close, song actions.",
      "html": "<button class=\"ds-btn ds-btn-ghost\">Hum this</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:var(--radius-control);border:1px solid transparent;font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 140ms var(--ease-out),border-color 140ms var(--ease-out),transform 120ms var(--ease-out)} .ds-btn:active{transform:scale(.97)} .ds-btn:focus-visible{outline:none;box-shadow:var(--focus-ring)} .ds-btn-ghost{background:transparent;color:var(--ink);border-color:var(--rule)} .ds-btn-ghost:hover{background:var(--paper);border-color:var(--rule-strong)}"
    },
    {
      "name": "Source Tabs",
      "kind": "nav",
      "refersTo": "source-tab",
      "description": "Input-source tabs cut from the roll paper on the walnut rail.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Microphone</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Demo hum</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Keys</button></div>",
      "css": ".ds-tabs{display:flex;align-items:flex-end;gap:2px;background:var(--walnut);padding:8px 12px 0} .ds-tab{height:44px;padding:0 16px;border:0;border-radius:var(--radius-control) var(--radius-control) 0 0;background:transparent;color:var(--on-walnut-2);font-family:var(--font-ui);font-weight:520;cursor:pointer;transition:background-color 140ms var(--ease-out),color 140ms var(--ease-out)} .ds-tab[aria-selected=true]{background:var(--paper-lo);color:var(--ink)} .ds-tab[aria-selected=false]:hover{background:var(--walnut-hi);color:var(--on-walnut)} .ds-tab:focus-visible{outline:none;box-shadow:inset 0 0 0 2px var(--leader-hi)}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field used in the library drawer; selects share the treatment.",
      "html": "<input class=\"ds-input\" placeholder=\"Search songs\" />",
      "css": ".ds-input{width:280px;height:38px;padding:0 12px;border:1px solid var(--rule);border-radius:var(--radius-control);background:var(--paper-hi);color:var(--ink);font-family:var(--font-ui);font-size:var(--text-base)} .ds-input::placeholder{color:var(--ink-3)} .ds-input:focus-visible{outline:none;box-shadow:var(--focus-ring)}"
    },
    {
      "name": "Interval Code (punched slots)",
      "kind": "custom",
      "refersTo": "step-slot",
      "description": "The signature data mark: each interval punched as a hole; S is an unpunched outline.",
      "html": "<div class=\"ds-steps\"><span class=\"ds-step\">S</span><span class=\"ds-step ds-punched\">U</span><span class=\"ds-step ds-punched\">U</span><span class=\"ds-step\">S</span><span class=\"ds-step ds-punched\">D</span><span class=\"ds-step ds-punched\">D</span></div>",
      "css": ".ds-steps{display:flex;gap:4px} .ds-step{display:inline-grid;place-items:center;width:24px;height:28px;border-radius:var(--radius-slot);font-family:var(--font-mono);font-size:var(--text-xs);font-weight:650;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--hole);animation:ds-punch 260ms var(--ease-out) both} .ds-punched{background:var(--hole);color:var(--paper-hi);box-shadow:none} @keyframes ds-punch{from{transform:scale(.6);opacity:0}}"
    },
    {
      "name": "Confidence Meter",
      "kind": "custom",
      "refersTo": "meter-slot-on",
      "description": "24 gold slots with threshold ticks; the only place gold appears. Shown locked in.",
      "html": "<div class=\"ds-meter\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i><i class=\"\"></i></div>",
      "css": ".ds-meter{position:relative;display:grid;grid-template-columns:repeat(24,1fr);gap:3px;height:18px;width:300px} .ds-meter i{border-radius:2px;background:var(--paper-edge);transition:background-color 220ms var(--ease-out)} .ds-meter i.on{background:var(--gold);box-shadow:inset 0 0 0 1px var(--gold-deep)} .ds-meter::before,.ds-meter::after{content:'';position:absolute;top:-4px;bottom:-4px;width:1px;background:var(--rule-strong)} .ds-meter::before{left:40%} .ds-meter::after{left:70%}"
    },
    {
      "name": "Leaderboard Row",
      "kind": "custom",
      "refersTo": "rank-slot-lead",
      "description": "Ruled row with rank slot, title, mono score and score bar; the lead is leader green.",
      "html": "<ol class=\"ds-board\"><li class=\"ds-row ds-lead\"><span class=\"ds-rank\">1</span><span class=\"ds-title\">Ode to Joy</span><span class=\"ds-score\">98.5</span><span class=\"ds-meta\">Ludwig van Beethoven</span><span class=\"ds-bar\"><span style=\"transform:scaleX(.98)\"></span></span></li><li class=\"ds-row\"><span class=\"ds-rank\">2</span><span class=\"ds-title\">Yankee Doodle</span><span class=\"ds-score\">83.1</span><span class=\"ds-meta\">Traditional (American)</span><span class=\"ds-bar\"><span style=\"transform:scaleX(.83)\"></span></span></li></ol>",
      "css": ".ds-board{list-style:none;margin:0;padding:0;width:360px;font-family:var(--font-ui);color:var(--ink)} .ds-row{display:grid;grid-template-columns:28px minmax(0,1fr) auto;grid-template-areas:'rank title score' 'rank meta score' 'rank bar bar';align-items:center;gap:0 12px;padding:8px 0;border-bottom:1px solid var(--rule)} .ds-rank{grid-area:rank;align-self:start;display:grid;place-items:center;width:24px;height:24px;border-radius:var(--radius-slot);box-shadow:inset 0 0 0 1.5px var(--rule-strong);font-family:var(--font-mono);font-size:var(--text-xs);font-weight:650} .ds-lead .ds-rank{background:var(--leader);color:var(--paper-hi);box-shadow:none} .ds-title{grid-area:title;font-weight:620;font-size:var(--text-md)} .ds-meta{grid-area:meta;color:var(--ink-2);font-size:var(--text-sm)} .ds-score{grid-area:score;font-family:var(--font-mono);font-size:var(--text-sm)} .ds-bar{grid-area:bar;height:3px;margin-top:4px;border-radius:2px;background:var(--paper-edge);overflow:hidden} .ds-bar span{display:block;height:100%;background:var(--ink-2);transform-origin:left;transition:transform 220ms var(--ease-out)} .ds-lead .ds-bar span{background:var(--leader)}"
    }
  ],
  "narrative": {
    "northStar": "The Player-Piano Roll",
    "overview": "The hum is a punched music roll and the search is that roll being read. The page is manila roll paper held in a dark walnut roll box: a walnut rail across the top carries the name, the input-source tabs and the start control; everything below sits on paper. Data is drawn as punched slots: notes on the roll, the interval code under it, the leaderboard ranks, the confidence meter and the piano keys' pressed state all use the same small rectangular hole. The search structures are the interface, so the trie and red-black tree get canvas and SVG space equal to the result itself.\n\nDensity is instrument-panel, not marketing: a 4px spacing base, 13-16px text, hairline rules between areas, and no cards. Because the app is projected in a classroom, the type ramp steps up one notch above 1200px and status is never carried by color alone (red nodes are outlined, black nodes filled; pruned branches end in a torn tick; rank changes carry an arrow).\n\nThe shipped build rejects the dark neon audio dashboard with glowing waveform and card grid. Surfaces are flat paper; depth appears only where a physical sheet sits on the page or a drawer slides over it.",
    "keyCharacteristics": [
      "Manila paper ground, walnut shell rail, black punched holes.",
      "Three roll-leader inks, each with exactly one job: green follows, vermilion tears, gold measures confidence.",
      "One variable grotesque (Archivo) whose width axis condenses headings; mono only for interval code and numbers.",
      "Hairline rules and paper edges divide areas; no cards, no glass.",
      "Strong ease-out motion for state changes; everything collapses under reduced motion."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "Each leader ink has a single meaning: green = followed, vermilion = red node or torn branch, gold = confidence. Never borrow one for decoration, emphasis or a different status.",
        "section": "colors"
      },
      {
        "name": "The Paper Sheet Rule",
        "body": "Anything drawn on (roll, trie, white keys, inputs) sits on `paper-hi`, one step paler than the `paper-lo` page, so punched `hole` marks hit full contrast.",
        "section": "colors"
      },
      {
        "name": "The Mono Is Data Rule",
        "body": "JetBrains Mono appears only on values the engine produced or consumes: intervals, notes, numbers, keyboard keys. Prose and labels stay in Archivo.",
        "section": "typography"
      },
      {
        "name": "The Width Axis Rule",
        "body": "Headings get hierarchy from width (condensed) and weight (620-680), not from large size jumps; only the locked-in title is allowed past 1.5rem.",
        "section": "typography"
      },
      {
        "name": "The Paper Sheet Lift Rule",
        "body": "Only sheets (roll, trie) and the drawer cast shadows. Panels, rows, buttons and inputs stay flat and are separated by hairlines.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** read every color from the CSS custom properties, including canvas drawing; the roll and trie canvases sample `--paper-hi`, `--leader`, `--vermilion` and the rest at runtime.",
      "**Do** keep each leader ink to its one job (green followed, vermilion red/torn, gold confidence).",
      "**Do** draw new data as punched slots on `paper-hi` sheets, with mono labels.",
      "**Do** divide areas with 1px `rule` hairlines and panel heads, not containers.",
      "**Do** use `cubic-bezier(0.23, 1, 0.32, 1)` at 140ms for control state changes and 220-320ms for data movement, and keep the reduced-motion collapse.",
      "**Do** pair every color-coded status with a second cue: outline vs fill, an arrow, a torn tick, or a text label.",
      "**Do** step type up one notch above 1200px for projection."
    ],
    "donts": [
      "**Don't** use the dark neon audio dashboard: no glowing waveform, no dark canvas, no card grid.",
      "**Don't** wrap panels in cards or frosted glass; only roll and trie sheets and the drawer get a shadow.",
      "**Don't** fill buttons with leader green, vermilion or gold; actions stay paper or walnut.",
      "**Don't** set prose, labels or headings in JetBrains Mono.",
      "**Don't** add a second sans or a display face; condense Archivo with its width axis instead."
    ]
  }

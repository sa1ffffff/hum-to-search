// Hand-written types for the Emscripten output (hts.mjs is generated by
// `npm run build:engine`; this file is not overwritten by the build).
import type { EngineModule } from '../types';

export interface EngineModuleOptions {
  locateFile?: (path: string, prefix: string) => string;
  wasmBinary?: ArrayBuffer | Uint8Array;
}

export default function createEngineModule(options?: EngineModuleOptions): Promise<EngineModule>;
